# Whitelist strategy: ignore everything, then re-include the agent-system files.
# Runtime state, caches, transcripts, and credentials must never be committed.
/*
!/.gitignore
!/CLAUDE.md
!/settings.json
!/statusline.py
!/agents/
!/skills/
!/rules/
!/patches/
!/plans/
!/plugins/
/plugins/*
!/plugins/installed_plugins.json
!/plugins/known_marketplaces.json
