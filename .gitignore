# Whitelist strategy: ignore everything, then re-include the agent-system files.
# Runtime state, caches, transcripts, credentials, and machine-specific config
# (settings.json, plugins/*.json) must never be committed — settings.json is
# reconstructed per machine by install.ps1 from templates/settings.json.
/*
!/.gitignore
!/.gitattributes
!/CLAUDE.md
!/README.md
!/install.ps1
!/statusline.py
!/agents/
!/skills/
!/rules/
!/patches/
!/plans/
!/templates/

# Plugin skills synced from claude.ai into skills/ and plugins/: third-party
# content, machine state, never ours to publish.
/skills/synced/
/plugins/synced/
