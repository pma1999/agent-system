{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4-flash",
  "small_model": "opencode/deepseek-v4-flash-free",
  "default_agent": "build",
  "subagent_depth": 2,
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless", "--browser", "chromium"],
      "enabled": true,
      "timeout": 20000
    }
  },
  "tools": {
    "playwright_*": false
  },
  "agent": {
    "build": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max",
      "tools": {
        "playwright_*": true
      },
      "permission": {
        "task": {
          "*": "ask",
          "explore": "allow",
          "diff-review": "allow",
          "consult": "allow",
          "review": "allow",
          "codebase-explorer": "deny",
          "integration-researcher": "deny",
          "implementation-planner": "deny",
          "root-cause-debugger": "deny",
          "task-implementer-bdd": "deny",
          "implementation-reviewer": "deny",
          "orquestador": "ask"
        },
        "skill": {
          "*": "allow",
          "orchestrator": "deny",
          "opencode-orchestrator": "deny"
        }
      }
    },
    "explore": {
      "model": "opencode-go/deepseek-v4-flash",
      "variant": "max",
      "steps": 25
    },
    "general": {
      "disable": true
    },
    "diff-review": {
      "description": "Reviews a completed change with no knowledge of how or why it was written. May run commands and write temp debug scripts to verify; never modifies code or git state. Use after the change is finished and the project's own checks pass, when the diff touches 3+ files or ~80+ lines, or touches auth, crypto, money, migrations, concurrency, deletion, or a public API, or when confidence is low.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-luna",
      "variant": "max",
      "steps": 25,
      "prompt": "{file:./prompts/diff-review.md}",
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.envrc": "deny",
          "*.env.example": "allow"
        },
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "bash": {
          "*": "allow",
          "rm *": "deny",
          "rm /tmp/opencode*": "allow",
          "rm -r /tmp/opencode*": "allow",
          "rm -rf /tmp/opencode*": "allow",
          "rm -f /tmp/opencode*": "allow",
          "rm -fr /tmp/opencode*": "allow",
          "rm *..*": "deny",
          "rm * * *": "deny",
          "mv *": "deny",
          "mv * *": "deny",
          "mv /tmp/opencode* /tmp/opencode*": "allow",
          "cp *": "deny",
          "cp * /tmp/opencode*": "allow",
          "touch *": "deny",
          "touch /tmp/opencode*": "allow",
          "mkdir *": "deny",
          "mkdir /tmp/opencode*": "allow",
          "mkdir -p /tmp/opencode*": "allow",
          "git reset*": "deny",
          "git clean*": "deny",
          "git checkout*": "deny",
          "git switch*": "deny",
          "git restore*": "deny",
          "git stash pop*": "deny",
          "git stash apply*": "deny",
          "git stash drop*": "deny",
          "git stash clear*": "deny",
          "git stash push*": "deny",
          "git stash save*": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git pull*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git cherry-pick*": "deny",
          "git revert*": "deny",
          "git apply*": "deny",
          "git rm*": "deny",
          "git mv*": "deny",
          "git branch -d*": "deny",
          "git branch -D*": "deny",
          "git branch -m*": "deny",
          "git branch -M*": "deny",
          "git tag -d*": "deny",
          "git update-ref*": "deny",
          "git remote add*": "deny",
          "git remote remove*": "deny",
          "git remote set-url*": "deny",
          "npm": "deny",
          "npm install*": "deny",
          "npm i*": "deny",
          "npm ci*": "deny",
          "npm add*": "deny",
          "npm update*": "deny",
          "npm audit fix*": "deny",
          "npx -y*": "deny",
          "npx --yes*": "deny",
          "bun x*": "deny",
          "pnpm dlx*": "deny",
          "bun install*": "deny",
          "bun i*": "deny",
          "bun add*": "deny",
          "bun update*": "deny",
          "yarn": "deny",
          "yarn add*": "deny",
          "yarn install*": "deny",
          "pnpm": "deny",
          "pnpm install*": "deny",
          "pnpm i*": "deny",
          "pnpm add*": "deny",
          "pip install*": "deny",
          "pip3 install*": "deny",
          "uv add*": "deny",
          "poetry add*": "deny",
          "cargo add*": "deny",
          "cargo install*": "deny",
          "go get*": "deny",
          "go mod tidy*": "deny",
          "apt install*": "deny",
          "apt-get install*": "deny",
          "brew install*": "deny",
          "sudo *": "deny",
          "mkfs*": "deny",
          "dd if=/dev/zero*": "deny",
          "dd if=/dev/random*": "deny",
          "dd of=/dev/*": "deny",
          "shutdown*": "deny",
          "reboot*": "deny",
          "poweroff*": "deny",
          "halt*": "deny",
          "black*": "deny",
          "black --check*": "allow",
          "ruff format*": "deny",
          "ruff format --check*": "allow",
          "go fmt*": "deny",
          "gofmt -w*": "deny",
          "*eslint --fix*": "deny",
          "*ruff check --fix*": "deny",
          "* .env*": "deny",
          "*/.env*": "deny",
          "* --write*": "deny",
          "* -delete*": "deny"
        },
        "edit": {
          "*": "deny",
          "/tmp/opencode/**": "allow"
        },
        "task": "deny",
        "todowrite": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "skill": "deny",
        "external_directory": {
          "*": "deny",
          "/tmp/opencode/**": "allow"
        }
      }
    },
    "consult": {
      "description": "Senior engineer consulted on one specific hard question. May run terminal checks and write temp debug scripts to decide; never modifies code or git state. Runs on the strongest available model. Use after two failed repair attempts on the same symptom, or for a design choice whose options cannot be distinguished from the code. Not for routine work.",
      "mode": "subagent",
      "model": "openai/gpt-5.6-sol",
      "variant": "xhigh",
      "steps": 20,
      "prompt": "{file:./prompts/consult.md}",
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
