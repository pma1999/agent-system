          "cp *": "deny",
          "cp * /tmp/opencode*": "allow",
          "touch *": "deny",
          "touch /tmp/opencode*": "allow",
          "mkdir *": "deny",
          "mkdir /tmp/opencode*": "allow",
          "mkdir -p /tmp/opencode*": "allow",
          "git reset*": "deny",
          "git clean*": "deny",
          "git checkout*": "deny",
          "git switch*": "deny",
          "git restore*": "deny",
          "git stash pop*": "deny",
          "git stash apply*": "deny",
          "git stash drop*": "deny",
          "git stash clear*": "deny",
          "git stash push*": "deny",
          "git stash save*": "deny",
          "git commit*": "deny",
          "git push*": "deny",
          "git pull*": "deny",
          "git merge*": "deny",
          "git rebase*": "deny",
          "git cherry-pick*": "deny",
          "git revert*": "deny",
          "git apply*": "deny",
          "git rm*": "deny",
          "git mv*": "deny",
          "git branch -d*": "deny",
          "git branch -D*": "deny",
          "git branch -m*": "deny",
          "git branch -M*": "deny",
          "git tag -d*": "deny",
          "git update-ref*": "deny",
          "git remote add*": "deny",
          "git remote remove*": "deny",
          "git remote set-url*": "deny",
          "npm": "deny",
          "npm install*": "deny",
          "npm i*": "deny",
          "npm ci*": "deny",
          "npm add*": "deny",
          "npm update*": "deny",
          "npm audit fix*": "deny",
          "npx -y*": "deny",
          "npx --yes*": "deny",
          "bun x*": "deny",
          "pnpm dlx*": "deny",
          "bun install*": "deny",
          "bun i*": "deny",
          "bun add*": "deny",
          "bun update*": "deny",
          "yarn": "deny",
          "yarn add*": "deny",
          "yarn install*": "deny",
          "pnpm": "deny",
          "pnpm install*": "deny",
          "pnpm i*": "deny",
          "pnpm add*": "deny",
          "pip install*": "deny",
          "pip3 install*": "deny",
          "uv add*": "deny",
          "poetry add*": "deny",
          "cargo add*": "deny",
          "cargo install*": "deny",
          "go get*": "deny",
          "go mod tidy*": "deny",
          "apt install*": "deny",
          "apt-get install*": "deny",
          "brew install*": "deny",
          "sudo *": "deny",
          "mkfs*": "deny",
          "dd if=/dev/zero*": "deny",
          "dd if=/dev/random*": "deny",
          "dd of=/dev/*": "deny",
          "shutdown*": "deny",
          "reboot*": "deny",
          "poweroff*": "deny",
          "halt*": "deny",
          "black*": "deny",
          "black --check*": "allow",
          "ruff format*": "deny",
          "ruff format --check*": "allow",
          "go fmt*": "deny",
          "gofmt -w*": "deny",
          "*eslint --fix*": "deny",
          "*ruff check --fix*": "deny",
          "* .env*": "deny",
          "*/.env*": "deny",
          "* --write*": "deny",
          "* -delete*": "deny"
        },
        "edit": {
          "*": "deny",
          "/tmp/opencode/**": "allow"
        },
        "task": "deny",
        "todowrite": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "skill": "deny",
        "external_directory": {
          "*": "deny",
          "/tmp/opencode/**": "allow"
        }
      }
    },
    "review": {
      "description": "Standalone code reviewer behind /review. Reviews uncommitted changes, a commit, a branch diff or a PR. May run commands and write temp debug scripts to verify; never modifies code or git state.",
      "mode": "subagent",
      "variant": "max",
      "steps": 25,
      "prompt": "{file:./prompts/review.md}",
      "permission": {
        "*": "deny",
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.envrc": "deny",
          "*.env.example": "allow"
        },
        "grep": "allow",
        "glob": "allow",
        "list": "allow",
        "bash": {
          "*": "allow",
          "rm *": "deny",
          "rm /tmp/opencode*": "allow",
          "rm -r /tmp/opencode*": "allow",
          "rm -rf /tmp/opencode*": "allow",
          "rm -f /tmp/opencode*": "allow",
          "rm -fr /tmp/opencode*": "allow",
          "rm *..*": "deny",
          "rm * * *": "deny",
          "mv *": "deny",
          "mv * *": "deny",
          "mv /tmp/opencode* /tmp/opencode*": "allow",
          "cp *": "deny",
          "cp * /tmp/opencode*": "allow",
          "touch *": "deny",
          "touch /tmp/opencode*": "allow",
          "mkdir *": "deny",
          "mkdir /tmp/opencode*": "allow",
          "mkdir -p /tmp/opencode*": "allow",
          "git reset*": "deny",
          "git clean*": "deny",
          "git checkout*": "deny",
          "git switch*": "deny",
          "git restore*": "deny",
          "git stash pop*": "deny",
          "git stash apply*": "deny",
          "git stash drop*": "deny",
          "git stash clear*": "deny",
          "git stash push*": "deny",
          "git stash save*": "deny",
          "git commit*": "deny",
