{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": ["codegraph", "serve", "--mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest", "--headless", "--browser", "chromium"],
      "enabled": true,
      "timeout": 20000
    }
  },
  "tools": {
    "playwright_*": false
  },
  "agent": {
    "build": {
      "tools": {
        "playwright_*": true
      }
    }
  },
  "permission": {
    "skill": {
      "*": "allow",
      "orchestrator": "deny"
    }
  }
}
