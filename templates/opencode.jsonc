          "git merge*": "deny",
          "git rebase*": "deny",
          "git cherry-pick*": "deny",
          "git revert*": "deny",
          "git apply*": "deny",
          "git rm*": "deny",
          "git mv*": "deny",
          "git branch -d*": "deny",
          "git branch -D*": "deny",
          "git branch -m*": "deny",
          "git branch -M*": "deny",
          "git tag -d*": "deny",
          "git update-ref*": "deny",
          "git remote add*": "deny",
          "git remote remove*": "deny",
          "git remote set-url*": "deny",
          "npm": "deny",
          "npm install*": "deny",
          "npm i*": "deny",
          "npm ci*": "deny",
          "npm add*": "deny",
          "npm update*": "deny",
          "npm audit fix*": "deny",
          "npx -y*": "deny",
          "npx --yes*": "deny",
          "bun x*": "deny",
          "pnpm dlx*": "deny",
          "bun install*": "deny",
          "bun i*": "deny",
          "bun add*": "deny",
          "bun update*": "deny",
          "yarn": "deny",
          "yarn add*": "deny",
          "yarn install*": "deny",
          "pnpm": "deny",
          "pnpm install*": "deny",
          "pnpm i*": "deny",
          "pnpm add*": "deny",
          "pip install*": "deny",
          "pip3 install*": "deny",
          "uv add*": "deny",
          "poetry add*": "deny",
          "cargo add*": "deny",
          "cargo install*": "deny",
