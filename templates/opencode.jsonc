  "command": {
    "review": {
      "description": "review changes [commit|branch|pr], defaults to uncommitted",
      "agent": "review",
      "subtask": true,
      "template": "Review the changes requested by the user. If the input below is empty, review the uncommitted changes.\n\nUser input: $ARGUMENTS"
    }
  },
  "permission": {
    "skill": {
      "*": "allow",
      "orchestrator": "deny"
    }
  }
}
